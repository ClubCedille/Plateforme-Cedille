resource "google_service_account" "tf_account" {
  account_id   = "tf-account"
  display_name = "TF Account"
}

resource "google_project_iam_member" "project" {
  project = var.gcloud_project
  role    = "roles/owner"
  member  = google_service_account.tf_account.member
}

# Terraform/OpenTofu runs use Workload Identity Federation or the
# GOOGLE_CREDENTIALS environment provided by CI. No long-lived service-account
# key is generated by this configuration.
